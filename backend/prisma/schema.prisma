generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  ARCHIVED
}

enum ProductCondition {
  NEW
}

enum ShippingCarrier {
  EMU_EXPRESS
  UZPOST
}

enum ShippingPayer {
  SENDER
  RECIPIENT
}

enum SellerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FinancialActionType {
  PAYOUT
  REFUND
  EXPENSE
}

enum FinancialActionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  CREATED
  AWAITING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

enum FinanceEntryType {
  INCOME
  EXPENSE
}

enum FinanceEntrySource {
  MANUAL
  PAYMENT
  REFUND
}

enum SupplierPurchaseStatus {
  PENDING
  READY
  SUBMITTING
  PLACED
  FULFILLING
  SHIPPED
  DELIVERED
  FAILED
  CANCELLED
  REFUND_REQUIRED
}

enum SupplierSettlementStatus {
  DRAFT
  APPROVED
  SENT
  SETTLED
  REJECTED
  FAILED
  CANCELLED
}

enum CainiaoShipmentStatus {
  PREPARED
  SUBMITTING
  ACCEPTED
  LABEL_READY
  IN_TRANSIT
  DELIVERED
  CANCEL_REQUESTED
  CANCELLED
  FAILED
}

model User {
  id            String         @id @default(cuid())
  phone         String?        @unique
  email         String?        @unique
  firebaseUid   String?        @unique
  passwordHash  String?
  name          String?
  city          String?
  address       String?
  language      String          @default("ru")
  role          UserRole       @default(CUSTOMER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orders        Order[]
  sessions      Session[]
  otpChallenges OtpChallenge[]
  cart          Cart?
  trackingEvents OrderTrackingEvent[] @relation("TrackingEventActor")
  financeEntries FinanceEntry[]       @relation("FinanceEntryActor")
  sellerProducts Product[]            @relation("SellerProducts")
  productImageAssets ProductImageAsset[]
  financialActionRequests FinancialActionRequest[]
  sellerApplication SellerApplication?
}

model OtpChallenge {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  consumedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([phone, expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([productId])
}

model Category {
  id        String    @id @default(cuid())
  parentId  String?
  parent    Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")
  nameUz    String
  nameRu    String
  attributes Json     @default("{}")
  products  Product[]
  createdAt DateTime  @default(now())

  @@index([parentId])
}

model ShippingBranch {
  id            String          @id @default(cuid())
  externalId    String          @unique
  carrier       ShippingCarrier @default(EMU_EXPRESS)
  name          String
  region        String
  locality      String
  address       String
  phone         String?
  workingHours  String?
  acceptsCash   Boolean         @default(false)
  acceptsCard   Boolean         @default(false)
  latitude      Float?
  longitude     Float?
  mapUrl        String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  products      Product[]       @relation("ProductDispatchBranch")

  @@index([carrier, region, locality])
  @@index([isActive])
}

model Product {
  id                String        @id @default(cuid())
  articleNumber     String        @unique @default(dbgenerated("('UR-'::text || lpad(nextval('uriona_article_number_seq'::regclass)::text, 6, '0'::text))"))
  sellerId          String?
  seller            User?         @relation("SellerProducts", fields: [sellerId], references: [id], onDelete: SetNull)
  categoryId        String?
  category          Category?     @relation(fields: [categoryId], references: [id])
  titleUz           String
  titleRu           String?
  descriptionUz     String?
  descriptionRu     String?
  imageUrl          String?
  imageUrls         Json              @default("[]")
  attributes        Json              @default("{}")
  variants          Json              @default("[]")
  stock             Int               @default(1)
  discountPercent   Int?
  condition         ProductCondition @default(NEW)
  sellerCity        String?
  sellerDistrict    String?
  pickupMethod      String            @default("SELLER_DELIVERY")
  shippingCarrier   ShippingCarrier   @default(EMU_EXPRESS)
  shippingPayer     ShippingPayer     @default(RECIPIENT)
  dispatchBranchId  String?
  dispatchBranch    ShippingBranch?   @relation("ProductDispatchBranch", fields: [dispatchBranchId], references: [id], onDelete: SetNull)
  dispatchPointName String?
  dispatchPointAddress String?
  publicationRulesAcceptedAt DateTime?
  restrictedGoodsConfirmedAt DateTime?
  moderationNote     String?
  currency          String        @default("CNY")
  priceMinor        Int
  status            ProductStatus @default(DRAFT)
  supplierProductRef String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  orderItems        OrderItem[]
  cartItems         CartItem[]

  @@index([categoryId])
  @@index([sellerId])
  @@index([dispatchBranchId])
  @@index([status])
}

model ProductImageAsset {
  id        String   @id @default(cuid())
  sellerId  String
  seller    User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  imageUrl  String   @unique
  objectKey String   @unique
  createdAt DateTime @default(now())

  @@index([sellerId])
}

model FinancialActionRequest {
  id          String               @id @default(cuid())
  sellerId    String
  seller      User                 @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  type        FinancialActionType
  status      FinancialActionStatus @default(PENDING)
  amountMinor Int
  currency    String               @default("UZS")
  description String
  reference   String?
  reviewNote  String?
  reviewedAt  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([sellerId, createdAt])
  @@index([status, createdAt])
}

model Order {
  id                String               @id @default(cuid())
  userId            String
  user              User                 @relation(fields: [userId], references: [id])
  status            OrderStatus          @default(CREATED)
  totalMinor        Int
  subtotalMinor     Int                  @default(0)
  deliveryMinor     Int                  @default(0)
  discountMinor     Int                  @default(0)
  promoCode         String?
  currency          String               @default("UZS")
  recipientName     String?
  recipientPhone    String?
  deliveryCity      String?
  deliveryAddress   String
  shippingCarrier   String?
  trackingNumber    String?
  trackingUpdatedAt DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  items             OrderItem[]
  payments          Payment[]
  trackingEvents    OrderTrackingEvent[]
  financeEntries    FinanceEntry[]
  cainiaoShipments  CainiaoShipment[]
  supplierPurchases SupplierPurchase[]

  @@index([userId])
  @@index([status])
  @@index([trackingNumber])
}

model OrderItem {
  id                    String  @id @default(cuid())
  orderId               String
  order                 Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId             String
  product               Product @relation(fields: [productId], references: [id])
  quantity              Int
  unitPriceMinor        Int
  supplierProductId     String?
  supplierSkuId         String?
  productTitle          String?
  variantLabel          String?
  imageUrl              String?
  shippingOptionCode    String?
  shippingFeeMinor      Int?
  shippingCompany       String?
  shippingFeeFormat     String?
  shippingCurrency      String?
  shippingMinDays       String?
  shippingMaxDays       String?
  shippingTracking      Boolean?
  shippingQuoteQuantity Int?

  @@index([orderId])
}

model Payment {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider       String
  externalRef    String?
  amountMinor    Int
  currency       String
  status         PaymentStatus  @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  financeEntries FinanceEntry[]

  @@index([orderId])
  @@unique([provider, externalRef])
}

model OrderTrackingEvent {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      String
  description String
  location    String?
  occurredAt  DateTime
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation("TrackingEventActor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orderId, occurredAt])
}

model FinanceEntry {
  id          String             @id @default(cuid())
  type        FinanceEntryType
  source      FinanceEntrySource @default(MANUAL)
  category    String
  description String
  amountMinor Int
  currency    String             @default("UZS")
  occurredAt  DateTime           @default(now())
  referenceId String?
  paymentId   String?
  payment     Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  orderId     String?
  order       Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?              @relation("FinanceEntryActor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())

  @@unique([source, referenceId])
  @@index([occurredAt])
  @@index([type, occurredAt])
  @@index([paymentId])
  @@index([orderId])
}

model CainiaoShipment {
  id                       String                @id @default(cuid())
  orderId                  String
  order                    Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  idempotencyKey           String                @unique
  requestFingerprint       String
  status                   CainiaoShipmentStatus @default(PREPARED)
  providerOrderReference   String?
  waybillNumber            String?
  carrierCode              String?
  labelStorageKey          String?
  providerErrorCode        String?
  providerErrorMessage     String?
  attemptCount             Int                   @default(0)
  lastAttemptAt            DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  trackingEvents           CainiaoTrackingEvent[]

  @@index([orderId, status])
  @@index([waybillNumber])
  @@index([providerOrderReference])
}

model CainiaoTrackingEvent {
  id              String         @id @default(cuid())
  shipmentId      String
  shipment        CainiaoShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  providerEventId String?
  status          String
  description     String
  location        String?
  occurredAt      DateTime
  createdAt       DateTime       @default(now())

  @@unique([shipmentId, providerEventId])
  @@index([shipmentId, occurredAt])
}

model AliexpressOAuthState {
  stateHash  String    @id
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
}

model AliexpressCredential {
  id                    String    @id @default("primary")
  accessTokenCiphertext String
  refreshTokenCiphertext String
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime?
  updatedAt             DateTime  @updatedAt
}


model SupplierPurchase {
  id                    String                 @id @default(cuid())
  orderId               String
  order                 Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider              String                 @default("aliexpress")
  status                SupplierPurchaseStatus @default(PENDING)
  idempotencyKey        String                 @unique
  requestFingerprint    String
  supplierCurrency      String                 @default("CNY")
  supplierAmountMinor   Int?
  supplierShippingMinor Int?
  externalOrderId       String?
  confirmationSource    String?
  confirmationReference String?
  lastErrorCode         String?
  lastErrorMessage      String?
  attemptCount          Int                    @default(0)
  lastAttemptAt         DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  settlements           SupplierSettlement[]

  @@unique([provider, externalOrderId])
  @@unique([orderId, provider])
  @@index([status, createdAt])
}

model SupplierSettlement {
  id                     String                   @id @default(cuid())
  purchaseId             String
  purchase               SupplierPurchase         @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  status                 SupplierSettlementStatus @default(DRAFT)
  idempotencyKey         String                   @unique
  beneficiaryName        String
  beneficiaryBank        String
  beneficiaryAccountRef  String
  contractReference      String
  currency               String
  amountMinor            Int
  bankReference          String?                  @unique
  proofStorageKey        String?
  approvedById           String?
  approvedAt             DateTime?
  initiatedAt            DateTime?
  settledAt              DateTime?
  failureReason          String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  @@index([purchaseId, status])
  @@index([status, createdAt])
}


model SellerApplication {
  id          String                  @id @default(cuid())
  userId      String                  @unique
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName   String
  logoUrl     String?
  description String
  categoryIds String[]                @default([])
  region      String
  city        String
  address     String?
  status      SellerApplicationStatus @default(PENDING)
  reviewNote  String?
  reviewedAt  DateTime?
  reviewedBy  String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([status, createdAt])
}
